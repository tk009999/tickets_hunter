<Window x:Class="TicketsHunter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tickets Hunter 搶票助手" Height="780" Width="940"
        MinHeight="680" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,18">
            <TextBlock Text="Tickets Hunter 搶票助手" FontSize="30" FontWeight="Bold" Foreground="#29264A"/>
            <TextBlock Text="三個步驟：貼上活動網址 → 選擇想要的票 → 開始搶票" FontSize="15" Foreground="#66627A" Margin="0,6,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="MainTabs" FontSize="15">
            <TabItem Header="1  活動與張數">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26" MaxWidth="780">
                        <TextBlock Text="活動售票網址" FontWeight="SemiBold"/>
                        <TextBox x:Name="UrlTextBox" ToolTip="從售票網站複製完整的活動網址"/>
                        <TextBlock Text="請貼上 TixCraft、TicketPlus、KKTIX 等活動頁的完整網址。" Foreground="#777" Margin="0,-7,0,16"/>

                        <TextBlock Text="購票張數" FontWeight="SemiBold"/>
                        <ComboBox x:Name="TicketCountCombo" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="1 張" Tag="1"/><ComboBoxItem Content="2 張" Tag="2"/>
                            <ComboBoxItem Content="3 張" Tag="3"/><ComboBoxItem Content="4 張" Tag="4"/>
                        </ComboBox>

                        <Border Background="#ECEAFF" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#403A83"
                                       Text="提醒：會員登入、實名資料、驗證碼與付款都由你在自己的 Chrome 處理，本程式不會上傳這些資料。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2  選擇日期與區域">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26" MaxWidth="780">
                        <TextBlock Text="日期／場次關鍵字" FontWeight="SemiBold"/>
                        <TextBox x:Name="DateKeywordsTextBox" ToolTip="例如：10/10 18:00;10/11 18:00"/>
                        <TextBlock Text="多個備選條件請用分號 ; 隔開，留空表示自動選擇。" Foreground="#777" Margin="0,-7,0,16"/>

                        <TextBlock Text="票價／區域關鍵字" FontWeight="SemiBold"/>
                        <TextBox x:Name="AreaKeywordsTextBox" ToolTip="例如：VIP;A區;3,280"/>
                        <TextBlock Text="例如：VIP;A區;3,280。程式會依填寫順序嘗試。" Foreground="#777" Margin="0,-7,0,16"/>

                        <TextBlock Text="不要的區域" FontWeight="SemiBold"/>
                        <TextBox x:Name="ExcludeKeywordsTextBox" Text="輪椅;身障;視線不良;燈柱遮蔽"/>

                        <TextBlock Text="選擇順序" FontWeight="SemiBold"/>
                        <ComboBox x:Name="SelectionModeCombo" Width="230" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="由上到下（推薦）" Tag="from top to bottom"/>
                            <ComboBoxItem Content="隨機選擇" Tag="random"/>
                            <ComboBoxItem Content="由下到上" Tag="from bottom to top"/>
                            <ComboBoxItem Content="從中間開始" Tag="center"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3  開始與狀態">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Border Background="White" BorderBrush="#DDD9EF" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#9AA0AA" Margin="0,0,10,0"/>
                                <TextBlock x:Name="StatusText" Text="尚未啟動" FontSize="17" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="LogTextBox" Margin="0,16,0,0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             Background="#171723" Foreground="#E9E9F3"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#777" Text="設定會自動儲存在這台電腦"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="儲存設定" Click="SaveButton_Click"/>
                <Button x:Name="StopButton" Content="暫停自動操作" Click="StopButton_Click" IsEnabled="False"
                        ToolTip="暫停後 Chrome 會保留，可以手動登入或操作頁面"/>
                <Button x:Name="StartButton" Content="開始搶票" Click="StartButton_Click"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
